{
  "name": "mcp-cli-starter-template",
  "version": "0.0.0",
  "private": true,
  "description": "Turborepo starter for MCP+CLI+TUI tools + the programmable scaffolder (`mcp-scaffold`) that generates and retrofits them. Includes robustness harness (watchdog/logger/shutdown), dispatcher invariants, stdio + Streamable HTTP transports, optional Rust acceleration, Mintlify docs, and matrix CI.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "volta": {
    "node": "24.13.0"
  },
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "init-template": "node scripts/init-template.mjs",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:no-native": "turbo run test:no-native",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "stress": "turbo run stress",
    "evaluate:retrofit": "node scripts/evaluate-retrofit.mjs",
    "check:robustness-package": "node scripts/check-robustness-package.mjs",
    "smoke:registry-runtime": "node scripts/smoke-registry-runtime.mjs",
    "check:usage": "pnpm --filter @george43g/mcp-scaffold check:usage && pnpm --filter \"@george43g/*-mcp\" check:usage",
    "check:docs": "node scripts/check-docs-links.mjs",
    "check:stdout-purity": "node scripts/check-stdout-purity.mjs",
    "check:stress-count": "node scripts/check-stress-count.mjs",
    "test:scripts": "node --test 'scripts/**/*.test.mjs'",
    "check:publishable-manifests": "node scripts/check-publishable-manifests.mjs",
    "check:registry-boundary": "node scripts/check-registry-boundary.mjs",
    "check:workflows": "actionlint .github/workflows/*.yml apps/scaffolder/src/phases/12-ci-release/lib/.github/workflows/*.yml example/.github/workflows/*.yml",
    "verify": "pnpm lint && pnpm test:scripts && pnpm check:docs && pnpm check:stdout-purity && pnpm check:stress-count && pnpm check:publishable-manifests && pnpm check:registry-boundary && pnpm check:workflows && pnpm check:turbo-tasks && pnpm check:usage && pnpm typecheck && pnpm test:coverage && pnpm build",
    "regen:example": "node scripts/regen-example.mjs example --build",
    "clean": "turbo run clean && rm -rf node_modules .turbo coverage",
    "test:coverage": "turbo run test:coverage",
    "check:deps-stale": "node scripts/check-deps-stale.mjs",
    "check:turbo-tasks": "node scripts/check-turbo-test-tasks.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@george43g/tsconfig": "workspace:*",
    "@george43g/vitest-config": "workspace:*",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^3.2.7",
    "semver": "^7.8.5",
    "tsx": "^4.23.1",
    "turbo": "^2.10.7",
    "typescript": "^5.7.0",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "overrides": {
      "@hono/node-server": "2.0.11",
      "fast-uri": "3.1.4",
      "postcss": "8.5.18",
      "@semantic-release/npm": "^13.1.5"
    }
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "cli",
    "tui",
    "ink",
    "commander",
    "starter",
    "template",
    "turborepo",
    "rust",
    "napi"
  ],
  "author": "George G",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/george43g/mcp-cli-starter-template.git"
  }
}
