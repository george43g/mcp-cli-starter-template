{
  "extends": "@george43g/tsconfig/node.json",
  "compilerOptions": {
    "composite": true,
    "emitDeclarationOnly": true,
    "rootDir": ".",
    "outDir": "./node_modules/.cache/tsc-test",
    "tsBuildInfoFile": "./node_modules/.cache/tsc-test/tsconfig.tsbuildinfo",
    "lib": ["ES2024"]
  },
  "include": ["src/**/*.test.ts"],
  "references": [{ "path": "./tsconfig.json" }, { "path": "./tsconfig.internal.json" }]
}
