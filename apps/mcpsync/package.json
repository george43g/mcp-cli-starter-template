{
  "name": "@george43g/mcpsync",
  "version": "0.1.0",
  "description": "Cross-host MCP config sync + drift TUI — one canonical ~/.mcp.json applied to every MCP host (Claude Code, Codex, Claude Desktop, Cursor, Warp, opencode) with dry-run previews, timestamped backups, a 0600 secrets vault, redacted secret scanning, and Claude Desktop extension hot-deploy.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/george43g/mcp-cli-starter-template.git",
    "directory": "apps/mcpsync"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "mcpsync": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "dev": "vite build --watch",
    "cli": "node dist/cli.js",
    "doctor": "node dist/cli.js doctor",
    "tui": "node dist/cli.js tui",
    "dev:tui": "tsx src/cli.ts tui",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "pack:check": "pnpm build && npm pack --dry-run --json",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "clean": "rm -rf dist coverage",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@george43g/robustness": "^0.1.1 || ^0.2.0",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.0",
    "fullscreen-ink": "^0.1.0",
    "ink": "^7.1.1",
    "picocolors": "^1.1.0",
    "react": "^19.2.8",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@george43g/cli-kit": "workspace:*",
    "@george43g/tsconfig": "workspace:*",
    "@george43g/tui-kit": "workspace:*",
    "@george43g/vitest-config": "workspace:*",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/npm": "^13.1.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@vitest/coverage-v8": "^3.2.7",
    "rollup-plugin-banner2": "^1.3.0",
    "semantic-release": "^24.2.0",
    "semantic-release-monorepo": "^8.0.2",
    "tsx": "^4.23.1",
    "typescript": "^5.7.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "cli",
    "config",
    "sync",
    "claude",
    "cursor"
  ],
  "author": "George G"
}
