{
  "name": "@george43g/mcpsync",
  "version": "0.0.0",
  "private": true,
  "description": "Cross-host MCP config sync — one canonical ~/.mcp.json applied to every MCP host (Claude Desktop, Cursor, Warp, …). Meta-repo tool; not scaffolded into generated repos.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "bin": {
    "mcpsync": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "cli": "node dist/cli.js",
    "doctor": "node dist/cli.js doctor",
    "tui": "node dist/cli.js tui",
    "dev:tui": "tsx src/cli.ts tui",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@george43g/cli-kit": "workspace:*",
    "@george43g/robustness": "workspace:*",
    "@george43g/tui-kit": "workspace:*",
    "commander": "^14.0.0",
    "fullscreen-ink": "^0.1.0",
    "ink": "^7.1.1",
    "react": "^19.2.8",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@george43g/tsconfig": "workspace:*",
    "@george43g/vitest-config": "workspace:*",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "rollup-plugin-banner2": "^1.3.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  },
  "keywords": [
    "mcp",
    "cli",
    "config",
    "sync"
  ],
  "author": "George G"
}
