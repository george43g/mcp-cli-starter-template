{
  "extends": "@george43g/tsconfig/node.json",
  "compilerOptions": {
    "outDir": "./node_modules/.cache/tsc",
    "rootDir": ".",
    "composite": true,
    "emitDeclarationOnly": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsc/tsconfig.tsbuildinfo"
  },
  "include": ["bin", "src", "tests"],
  "exclude": ["src/phases/**/lib/**", "dist", "coverage"]
}
