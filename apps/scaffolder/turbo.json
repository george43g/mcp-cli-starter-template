{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "test": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "tests/**",
        "vitest.config.ts",
        "$TURBO_ROOT$/AGENTS.md",
        "$TURBO_ROOT$/LICENSE",
        "$TURBO_ROOT$/llms-install.md",
        "$TURBO_ROOT$/.github/**",
        "$TURBO_ROOT$/docs/**",
        "$TURBO_ROOT$/packages/*/src/**",
        "$TURBO_ROOT$/packages/*/README.md",
        "$TURBO_ROOT$/apps/example-repo-mcp/**",
        "$TURBO_ROOT$/apps/rust-accel/**"
      ]
    }
  }
}
