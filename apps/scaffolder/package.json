{
  "name": "@george43g/mcp-scaffold",
  "version": "0.0.0",
  "description": "Programmable scaffolder + migrator for mcp-cli-starter-template. Generates a fresh starter or applies subsets of rules to an existing MCP repo.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/cli.js",
  "bin": {
    "mcp-scaffold": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "start": "tsx bin/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.0.0",
    "commander": "^14.0.0",
    "execa": "^9.5.0",
    "kleur": "^4.1.5",
    "ora": "^8.1.0"
  },
  "devDependencies": {
    "@george43g/tsconfig": "workspace:*",
    "@george43g/vitest-config": "workspace:*",
    "@types/node": "^24.0.0",
    "rollup-plugin-banner2": "^1.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vitest": "^2.1.0"
  },
  "keywords": [
    "mcp",
    "scaffold",
    "starter",
    "generator",
    "migrator"
  ],
  "author": "George G"
}
